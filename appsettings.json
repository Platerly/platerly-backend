{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [
      "https://platerly.com",
      "https://www.platerly.com"
    ]
  },

  "RateLimiting": {
    "GeneralPermitLimit": 100,
    "AnonymousPermitLimit": 30,
    "AuthPermitLimit": 10,
    "WindowMinutes": 1
  },

  "FileUpload": {
    "MaxImageBytes": 8000000,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".gif" ]
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Platerly",
    "Audience": "PlaterlyUsers",
    "ExpiresInMinutes": 60
  },
  "AuthCookies": {
    "RefreshCookieName": "Platerly.r",
    "Domain": ".platerly.com",
    "Secure": true,
    "SameSite": "None"
  },

  "AzureStorage": {
    "ConnectionString": "",
    "ContainerName": ""
  },
  "SendGrid": {
    "ApiKey": "",
    "SenderEmail": "noreply@platerly.com",
    "SenderName": "Platerly"
  },
  "FrontendBaseUrl": "",
  "BackendBaseUrl": "",
  "PublicBaseUrl": "https://platerly.com",
  "Stripe": {
    "SecretKey": "",
    "PriceIdPremium": "",
    "WebhookSecret": "",
    "PublicDomainProd": "",
    "AllowPromoCodes": true,
    "EnableAutomaticTax": false
  }

}
